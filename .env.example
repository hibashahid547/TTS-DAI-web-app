# Server
PORT=8965

# TTS device: cuda for GPU hosts (Docker default), cpu for CPU-only
TTS_DEVICE=cuda

# Logging
LOG_LEVEL=INFO

# Hugging Face
HF_HUB_DISABLE_PROGRESS_BARS=0
# Optional: HF_TOKEN=hf_xxx

# Optional host paths (local Windows only; Docker image includes ffmpeg)
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# ===========================
# PostgreSQL Data API (PostgREST)
# ===========================

DATA_API_URL=
DATA_API_KEY=

# Optional: used only by scripts/migrate.py to apply SQL schema
DATABASE_URL=

# ===========================
# Object Store API
# ===========================

STORE_API_URL=
STORE_API_KEY=

# ===========================
# Database Tables
# ===========================

SPEAKERS_TABLE=speakers
SPEAKER_EMOTIONS_TABLE=speaker_emotions
GENERATIONS_TABLE=tts_generations

# ===========================
# Storage Buckets
# ===========================

SPEAKERS_BUCKET=tts-speakers
GENERATIONS_BUCKET=tts-generations

# ===========================
# Local cache
# ===========================

VOICE_CACHE_DIR=voices/cache

# Max reference audio length for speaker emotion uploads (seconds)
REF_AUDIO_MAX_SECONDS=300
